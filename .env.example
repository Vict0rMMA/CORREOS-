# ---------------------------------------------------------------
# PAULA CORREOS - variables de entorno
# Copia este archivo como .env.local y rellena el valor.
# Nunca subas .env.local al repositorio.
# ---------------------------------------------------------------

# Clave de la API de Google Gemini (obligatoria). Solo se usa en el servidor.
# Consiguela gratis en https://aistudio.google.com/apikey
AI_API_KEY=

# Modelo a usar (opcional). Por defecto: gemini-flash-lite-latest
#   gemini-flash-lite-latest  rapido y con la cuota gratuita mas amplia
#   gemini-flash-latest       algo mas de calidad (cuota gratuita muy baja)
#   gemini-pro-latest         maxima calidad (requiere plan de pago)
# AI_MODEL=gemini-flash-lite-latest

# Modelo de emergencia si el principal esta saturado (opcional).
# Por defecto: gemini-flash-latest. Dejalo vacio para desactivarlo.
# AI_MODEL_FALLBACK=gemini-flash-latest

# Clave de respaldo (opcional): otra clave gratuita, de OTRA cuenta de Google.
# Solo se usa si la principal se queda sin cupo del dia o no responde; no
# choca con la principal. Asi la traduccion dura el doble.
# AI_API_KEY_RESPALDO=

# Limite de caracteres por peticion (opcional). Por defecto: 12000
# AI_MAX_INPUT_CHARS=12000

# ---------------------------------------------------------------
# Supabase: donde se guardan las planillas y los correos (opcional).
# Sin estas dos, la aplicacion funciona igual y todo queda en el navegador.
# ---------------------------------------------------------------

# Direccion del proyecto. No es secreta.
# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=

# Clave SECRETA (empieza por sb_secret_). Solo la usa el servidor.
# Supabase > Project Settings > API Keys > Secret keys
# Nunca la pegues en un chat ni la pongas en una variable NEXT_PUBLIC_:
# con ella se puede leer y cambiar toda la base.
SUPABASE_SECRET_KEY=
